{
  "version": 2,
  "builds": [
    {
      "src": "src/app.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/pdfkit/js/standard-fonts/**/*",
          "node_modules/.pnpm/pdfkit@0.20.2/node_modules/pdfkit/js/standard-fonts/**/*"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app.ts"
    }
  ]
}